FROM node:22-alpine AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN for encoded in apps/web/public/assets/*.b64 apps/web/public/icons/*.b64; do \
      [ -f "$encoded" ] || continue; \
      base64 -d "$encoded" > "${encoded%.b64}"; \
      rm "$encoded"; \
    done
RUN pnpm install --frozen-lockfile
RUN pnpm db:generate
RUN pnpm build

FROM node:22-alpine AS runtime

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV SERVE_WEB=true
ENV WEB_DIST_PATH=apps/web/dist
ENV DATABASE_DISABLED=true
ENV DATABASE_REQUIRED=false
ENV CORS_ORIGINS=*

WORKDIR /app
COPY --from=build /app /app

EXPOSE 3000
CMD ["node", "apps/server/dist/src/index.js"]
